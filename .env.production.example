# Telegram token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-telegram-token

# Service name and internal port of Consilium in the consilium-internal network.
CONSILIUM_API_URL=http://consilium:8000

# Must exactly match BOT_INTEGRATION_SECRET in Consilium's .env.
BOT_INTEGRATION_SECRET=replace-with-the-same-long-random-secret

POLLING_TIMEOUT=30
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
HEALTHCHECK_FILE=/tmp/consilium-tg-bot.heartbeat
HEALTHCHECK_MAX_AGE=120
