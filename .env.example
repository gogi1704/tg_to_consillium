# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Для локального «Консилиума»:
CONSILIUM_API_URL=http://127.0.0.1:8000

# Должен полностью совпадать с BOT_INTEGRATION_SECRET в .env «Консилиума».
BOT_INTEGRATION_SECRET=

POLLING_TIMEOUT=30
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
HEALTHCHECK_FILE=/tmp/consilium-tg-bot.heartbeat
HEALTHCHECK_MAX_AGE=120
